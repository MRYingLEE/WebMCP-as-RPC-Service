{
  "name": "jupyter-webmcp-ui-tests",
  "version": "1.0.0",
  "description": "jupyter-webmcp Integration Tests",
  "private": true,
  "scripts": {
    "build:lite": "bash build_lite.sh",
    "start": "jupyter lab --config jupyter_server_test_config.py",
    "start:lite": "python serve_lite.py",
    "start:notebook": "jupyter notebook --config jupyter_server_test_config.py",
    "test": "jlpm playwright test",
    "test:update": "jlpm playwright test --update-snapshots"
  },
  "devDependencies": {
    "@jupyterlab/galata": "^5.6.4",
    "@playwright/test": "^1.64.1"
  }
}
